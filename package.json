{
  "name": "n8n-nodes-parseur",
  "version": "0.0.8",
  "description": "🧩 Official n8n Trigger Node to receive document processing events from [Parseur](https://parseur.com) and automate your workflows.",
  "keywords": [
    "n8n-community-node-package",
    "parseur",
    "parseur.com",
    "parsuer",
    "parser",
    "email parser",
    "document parser",
    "webhook",
    "automation",
    "workflow automation",
    "data extraction"
  ],
  "author": {
    "name": "Parseur Team",
    "email": "admin@parseur.com"
  },
  "license": "MIT",
  "homepage": "http://parseur.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/parseur/parseur-n8n-node"
  },
  "auto-changelog": {
    "commitUrl": "https://github.com/parseur/parseur-n8n-node/commit/{id}",
    "compareUrl": "https://github.com/parseur/parseur-n8n-node/compare/{from}...{to}",
    "issueUrl": "https://github.com/parseur/parseur-n8n-node/issues/{id}",
    "mergeUrl": "https://github.com/parseur/parseur-n8n-node/pull/{id}"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ParseurApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Parseur/Parseur.node.js",
      "dist/nodes/Parseur/ParseurTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@n8n/node-cli": "*",
    "eslint": "10.6.0",
    "prettier": "3.9.6",
    "release-it": "^20.0.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "lodash": "^4.18.1",
    "uuid": "^11.1.1",
    "file-type": "^21.3.1"
  }
}
